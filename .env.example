# Database - Neon PostgreSQL
# Get your connection string from https://neon.tech
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# OpenAI API Key
# Required for Ava's visible chat lane by default.
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# StepFun API Key
# Used for Ava's hidden extraction lane when present. Optional for visible
# chat unless AVA_USE_STEPFUN_FOR_CHAT="1".
STEPFUN_API_KEY=""

# Optional overrides (safe to omit — defaults shown)
# STEPFUN_MODEL="step-3.5-flash"
# STEPFUN_BASE_URL="https://api.stepfun.ai/step_plan/v1"

# Optional experiment flag — route Ava's visible chat lane to StepFun too.
# Leave unset (or "0") to keep visible chat on OpenAI.
# AVA_USE_STEPFUN_FOR_CHAT="0"

# GIPHY API Key (optional, used by Emma's GIF reactions)
# GIPHY_API_KEY=""
